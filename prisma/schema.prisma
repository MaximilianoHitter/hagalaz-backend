generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                      String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  email                   String @unique
  first_name              String
  last_name               String
  password_hash           String @db.Text
  api_secret_encrypted    String @db.Text
  api_secret_iv           String @db.Text
  api_secret_auth_tag     String @db.Text
  failed_loggin_attempts  Int @default(0)
  last_login_at           DateTime
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  bloqued                 Boolean @default(false)

  sessions                sessions[]
  requestnonces           requestnonces[]
  auditlogs               auditlogs[]

  @@index([email])
  @@map("USERS")
}

model sessions {
  id                      String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  id_user                 String @db.Uuid
  token_hash              String @db.Text
  fingerprint_hash        String @db.Text
  login_ip                String
  user_agent              String @db.Text
  created_at              DateTime @default(now())
  expires_at              DateTime
  last_activity_at        DateTime
  revoked                 Boolean @default(false)
  revoked_reason          String @db.Text
  revoked_at              DateTime?

  user                    user @relation(fields:[id_user], references:[id])

  @@index([id_user])
  @@index([token_hash])
  @@index([fingerprint_hash])
  @@index([login_ip])
  @@index([user_agent])
  @@map("SESSIONS")
}

model requestnonces {
  id                    String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  id_user               String @db.Uuid
  nonce                 String @db.Text @unique
  timestamp             DateTime
  created_at            DateTime

  user                  user @relation(fields:[id_user], references:[id])

  @@index([id_user])
  @@index([nonce])
  @@map("REQUEST_NONCES")
}

model auditlogs {
  id                    String @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  id_user               String @db.Uuid
  action                String @db.Text
  ip_address            String @db.Text
  user_agent            String @db.Text
  metadata              Json
  created_at            DateTime @default(now())

  user                  user @relation(fields:[id_user], references:[id])

  @@index([id_user])
  @@index([action])
  @@map("AUDIT_LOGS")
}


